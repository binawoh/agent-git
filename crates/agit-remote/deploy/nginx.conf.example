# Merge into the Hub's existing HTTPS server block; replace history.example.com with the Hub's
# domain. The map belongs in the http context: a site file included by nginx.conf is inside it.
map $http_upgrade $connection_upgrade {
    default upgrade;
    ''      close;
}

server {
    listen 443 ssl;
    server_name history.example.com;
    # ... the Hub's existing certificate and limits ...

    # Presence and data sockets stay open for as long as a device is online; the relay pings
    # them well inside these timeouts.
    location /api/peer/ {
        proxy_pass http://127.0.0.1:8178;
        proxy_http_version 1.1;
        proxy_set_header Upgrade $http_upgrade;
        proxy_set_header Connection $connection_upgrade;
        proxy_set_header Host $host;
        proxy_set_header X-Forwarded-Proto https;
        proxy_read_timeout 3600s;
        proxy_send_timeout 3600s;
        proxy_buffering off;
        proxy_request_buffering off;
    }

    location /console {
        proxy_pass http://127.0.0.1:8178;
        proxy_http_version 1.1;
        proxy_set_header Upgrade $http_upgrade;
        proxy_set_header Connection $connection_upgrade;
        proxy_set_header Host $host;
        proxy_set_header X-Forwarded-Proto https;
        proxy_read_timeout 3600s;
        proxy_send_timeout 3600s;
        proxy_buffering off;
    }

    location / {
        proxy_pass http://127.0.0.1:8177;
        # ... the Hub's existing settings ...
    }
}
